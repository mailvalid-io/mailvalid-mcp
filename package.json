{
  "name": "@mailvalid/mcp",
  "version": "0.1.0",
  "description": "Stdio launcher that proxies to MailValid's hosted MCP server (https://mailvalid.io/mcp/) for MCP clients that only support local stdio servers",
  "main": "dist/index.js",
  "bin": {
    "mailvalid-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": ["mcp", "model context protocol", "email verification", "mailvalid", "claude", "agent tools"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mailvalid/mailvalid-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
